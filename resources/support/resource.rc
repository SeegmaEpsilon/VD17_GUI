#include <windows.h>

IDI_ICON1               ICON    DISCARDABLE     "oscilloscope.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "administration.manifest"

1 VERSIONINFO
FILEVERSION 2,5,1,0
PRODUCTVERSION 2,5,1,0
FILEOS 0x4
FILETYPE 0x0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Micronix Ltd."
      VALUE "FileDescription", "GUI for interaction with the wireless vibration sensor VD21"
      VALUE "FileVersion", "1.0.2"
      VALUE "InternalName", "VD21 Service"
      VALUE "LegalCopyright", "Copyright © 2026 Micronix Ltd."
      VALUE "OriginalFilename", "VD21 Service"
      VALUE "ProductName", "VD21 Service"
      VALUE "ProductVersion", "1.0.2"
    END
  END 
  
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
